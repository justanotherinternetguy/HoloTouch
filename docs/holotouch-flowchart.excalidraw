   "versionNonce": 284986701,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "THE OPTIONAL POSE MODEL, BY COMPARISON\n\nx = 105 distances in world / L\n  ⊕ 105 in the picture / P              (210)\n210 → 48 ReLU → softmax(6), 400 steps,\nGaussian noise σ = 0.15 on z each step,\naccept if p_max ≥ 0.6\n\nDistances only, so it does not care which way the hand is turned or\nwhich hand it is.",
   "originalText": "THE OPTIONAL POSE MODEL, BY COMPARISON\n\nx = 105 distances in world / L\n  ⊕ 105 in the picture / P              (210)\n210 → 48 ReLU → softmax(6), 400 steps,\nGaussian noise σ = 0.15 on z each step,\naccept if p_max ≥ 0.6\n\nDistances only, so it does not care which way the hand is turned or which hand it is.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0795",
   "lineHeight": 1.2,
   "autoResize": true
  },
