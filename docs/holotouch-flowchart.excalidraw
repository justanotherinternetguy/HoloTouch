   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PINCH STRENGTH, FOR THE CURSOR RING\n\nr = the pose's own distance (else min(index, pinky))\nstrength = clamp((0.672 − r) / 0.547, 0, 1)\n           0.672 = 1.6·exit,  0.125 = ½·enter",
   "originalText": "PINCH STRENGTH, FOR THE CURSOR RING\n\nr = the pose's own distance (else min(index, pinky))\nstrength = clamp((0.672 − r) / 0.547, 0, 1)\n           0.672 = 1.6·exit,  0.125 = ½·enter",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0349",
   "lineHeight": 1.2,
   "autoResize": true
  },
