   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMOOTH SCROLLING\n\nacc ← acc + notches·120         hi-res units\nunits = trunc(acc);  acc ← acc − units\nemit REL_WHEEL_HI_RES(units)\nemit REL_WHEEL(1) for every whole 120 accumulated\n\nThe remainder is carried to the next tick, so a slow tilt still\nscrolls evenly.",
   "originalText": "SMOOTH SCROLLING\n\nacc ← acc + notches·120         hi-res units\nunits = trunc(acc);  acc ← acc − units\nemit REL_WHEEL_HI_RES(units)\nemit REL_WHEEL(1) for every whole 120 accumulated\n\nThe remainder is carried to the next tick, so a slow tilt still scrolls evenly.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0826",
   "lineHeight": 1.2,
   "autoResize": true
  },
