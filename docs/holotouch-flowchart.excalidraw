  {
   "id": "ht0234",
   "type": "text",
   "x": 612.0,
   "y": 2998.0,
   "width": 586,
   "height": 352.8,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1872053693,
   "version": 1,
   "versionNonce": 418341499,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "THE MEASUREMENTS\n\nL = ‖w[9] − w[0]‖        wrist to middle knuckle\n\ncurl[i]      = ‖tip − knuckle‖ / L        index..pinky\n               curled 0.2–0.55, relaxed 0.6+\nstraight[i]  = ‖tip − knuckle‖ / (sum of 3 bone lengths)\n               flat 0.96+, relaxed ~0.9, claw 0.63–0.80\npinch_index  = min(‖thumb − index tip‖ / L, picture pinch)\n               touching ~0.15, relaxed 0.4–0.6\npinch_pinky  = ‖thumb tip − pinky tip‖ / L\npinch_others = min(thumb–middle tip, thumb–ring tip) / L\nthumb_tuck   = thumb tip to the nearest point on the\n               middle finger's three bones, / L\nfacing       = |n_z| / ‖n‖\n               n = (w[5] − w[0]) × (w[17] − w[0])\n               1 square to the camera, 0 side-on\nfinger_tilt  = atan2(−d_z, −d_y)\n               d = (w[8] − w[5]) + (w[12] − w[9])\n               0° up, 90° at the camera, < 0 leaning back\npalm         = mean of picture landmarks 0, 5, 17",
   "originalText": "THE MEASUREMENTS\n\nL = ‖w[9] − w[0]‖        wrist to middle knuckle\n\ncurl[i]      = ‖tip − knuckle‖ / L        index..pinky\n               curled 0.2–0.55, relaxed 0.6+\nstraight[i]  = ‖tip − knuckle‖ / (sum of 3 bone lengths)\n               flat 0.96+, relaxed ~0.9, claw 0.63–0.80\npinch_index  = min(‖thumb − index tip‖ / L, picture pinch)\n               touching ~0.15, relaxed 0.4–0.6\npinch_pinky  = ‖thumb tip − pinky tip‖ / L\npinch_others = min(thumb–middle tip, thumb–ring tip) / L\nthumb_tuck   = thumb tip to the nearest point on the\n               middle finger's three bones, / L\nfacing       = |n_z| / ‖n‖\n               n = (w[5] − w[0]) × (w[17] − w[0])\n               1 square to the camera, 0 side-on\nfinger_tilt  = atan2(−d_z, −d_y)\n               d = (w[8] − w[5]) + (w[12] − w[9])\n               0° up, 90° at the camera, < 0 leaning back\npalm         = mean of picture landmarks 0, 5, 17",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0233",
   "lineHeight": 1.2,
   "autoResize": true
  },
