   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHAT EACH COMMAND BECOMES\n\nmove, resize      _NET_MOVERESIZE_WINDOW\nmaximize          _NET_WM_STATE (max. vert + horz)\nminimize          WM_CHANGE_STATE → iconic\nclose             _NET_CLOSE_WINDOW\nbring to front    _NET_ACTIVE_WINDOW\nworkspace         _NET_CURRENT_DESKTOP, _NET_WM_DESKTOP\nclick, drag, keys XTEST\nscroll            /dev/uinput virtual mouse (XTEST fallback)\nvolume            pactl set-sink-volume\nbrightness        /sys/class/backlight\nskip track        playerctl next | previous\ntype text         xdotool type\napps, macros      gtk-launch, xdg-open, shell",
   "originalText": "WHAT EACH COMMAND BECOMES\n\nmove, resize      _NET_MOVERESIZE_WINDOW\nmaximize          _NET_WM_STATE (max. vert + horz)\nminimize          WM_CHANGE_STATE → iconic\nclose             _NET_CLOSE_WINDOW\nbring to front    _NET_ACTIVE_WINDOW\nworkspace         _NET_CURRENT_DESKTOP, _NET_WM_DESKTOP\nclick, drag, keys XTEST\nscroll            /dev/uinput virtual mouse (XTEST fallback)\nvolume            pactl set-sink-volume\nbrightness        /sys/class/backlight\nskip track        playerctl next | previous\ntype text         xdotool type\napps, macros      gtk-launch, xdg-open, shell",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0824",
   "lineHeight": 1.2,
   "autoResize": true
  },
