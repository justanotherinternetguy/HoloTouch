  {
   "id": "ht0116",
   "type": "text",
   "x": 972.0,
   "y": 1546,
   "width": 586,
   "height": 134.4,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
