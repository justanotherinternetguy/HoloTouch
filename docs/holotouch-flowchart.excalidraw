  {
   "id": "ht0191",
   "type": "text",
   "x": 4512.0,
   "y": 1546,
   "width": 586,
   "height": 235.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
