   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY TWO CLOCKS\n\nSamples land about every 33 ms; the screen redraws every 16.7 ms or\nfaster. A cursor that only moved on samples would step. So positions\nare filtered per sample and predicted per tick (stage 4).",
   "originalText": "WHY TWO CLOCKS\n\nSamples land about every 33 ms; the screen redraws every 16.7 ms or faster. A cursor that only moved on samples would step. So positions are filtered per sample and predicted per tick (stage 4).",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0148",
   "lineHeight": 1.2,
   "autoResize": true
  },
