   "link": null,
   "locked": false,
   "text": "CAMERA BOX TO SCREEN\n\nn = (p − (0.15, 0.20)) / (0.70, 0.60)     box → 0..1\nn = (n − ½)·(1 + 2·0.04) + ½              overshoot\ns = (n_x · W/H, n_y)                      screen heights",
   "originalText": "CAMERA BOX TO SCREEN\n\nn = (p − (0.15, 0.20)) / (0.70, 0.60)     box → 0..1\nn = (n − ½)·(1 + 2·0.04) + ½              overshoot\ns = (n_x · W/H, n_y)                      screen heights",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0214",
   "lineHeight": 1.2,
   "autoResize": true
