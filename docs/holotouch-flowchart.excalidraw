   "versionNonce": 480607733,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Lay out the cards\nMost recently used first; the highlight starts on the\nwindow before the current one, like Alt+Tab.\nfit = floor((usable_w − 2·pad + gap)/(card_w + gap))\ncolumns = max(min(6, fit), 1)\nrows = ceil(n/columns), columns = ceil(n/rows)\nu = scale·min(1, usable_w/w, usable_h/h)",
   "originalText": "Lay out the cards\nMost recently used first; the highlight starts on the window before the current one, like Alt+Tab.\nfit = floor((usable_w − 2·pad + gap)/(card_w + gap))\ncolumns = max(min(6, fit), 1)\nrows = ceil(n/columns), columns = ceil(n/rows)\nu = scale·min(1, usable_w/w, usable_h/h)",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0652",
   "lineHeight": 1.15,
   "autoResize": true
  },
