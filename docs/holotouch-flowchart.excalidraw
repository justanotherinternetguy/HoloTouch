   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One hand: move\nrect_xy = hand_xy + offset\nx ∈ [80 − w, W − 80],  y ∈ [work_y, H − 80]\nHand within 2% of W from a side edge for 350 ms: window and\nview go to the next workspace (900 ms cooldown).",
   "originalText": "One hand: move\nrect_xy = hand_xy + offset\nx ∈ [80 − w, W − 80],  y ∈ [work_y, H − 80]\nHand within 2% of W from a side edge for 350 ms: window and view go to the next workspace (900 ms cooldown).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ht0487",
   "lineHeight": 1.15,
   "autoResize": true
