  {
   "id": "text-53",
   "type": "text",
   "x": 1239.2,
   "y": 915.0,
   "width": 470.4,
   "height": 172.8,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "group-50"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 524193278,
   "version": 1,
   "versionNonce": 175782304,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "palm = mean( wrist, index MCP, pinky MCP )\nd    = ‖palm_track − palm_detection‖\n       [fractions of the frame]\ncost = ∞                              if d > 0.30\n     = d + 0.15·[handedness differs]  otherwise\npick the assignment with the least Σ cost\n  (every permutation is tried: ≤ 2 tracks)\nnone finite → each track takes its nearest\nunseen for 250 ms → the track is dropped",
   "originalText": "palm = mean( wrist, index MCP, pinky MCP )\nd    = ‖palm_track − palm_detection‖\n       [fractions of the frame]\ncost = ∞                              if d > 0.30\n     = d + 0.15·[handedness differs]  otherwise\npick the assignment with the least Σ cost\n  (every permutation is tried: ≤ 2 tracks)\nnone finite → each track takes its nearest\nunseen for 250 ms → the track is dropped",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
   "baseline": 168
