  {
   "id": "text-137",
   "type": "text",
   "x": 871.2,
   "y": 3904.4,
   "width": 518.4,
   "height": 249.6,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
