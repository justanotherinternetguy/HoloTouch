  {
   "id": "text-97",
   "type": "text",
   "x": 1028.0,
   "y": 2602.2,
   "width": 518.4,
   "height": 115.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
