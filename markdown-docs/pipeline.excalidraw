  {
   "id": "text-109",
   "type": "text",
   "x": 1750.4,
   "y": 2602.2,
   "width": 499.2,
   "height": 403.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
