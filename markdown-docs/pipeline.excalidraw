   "text": "Track association: stable hand ids  (hands.py)",
   "originalText": "Track association: stable hand ids  (hands.py)",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
