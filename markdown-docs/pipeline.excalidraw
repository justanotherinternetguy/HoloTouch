   "seed": 360881140,
   "version": 1,
   "versionNonce": 1311939741,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "OPEN, armed, facing ≥ 0.5, slowed below 0.3 H/s since\n(x₀, y₀) = leftmost point of the last 350 ms\ndx = ux − x₀,   dy = uy − y₀\nfires if   dx ≥ 0.30 · W   and   dx ≥ 2.5 · |dy|\nthen 700 ms of cooldown; never while the palms are\nunder 0.35 m apart (that is clapping)",
   "originalText": "OPEN, armed, facing ≥ 0.5, slowed below 0.3 H/s since\n(x₀, y₀) = leftmost point of the last 350 ms\ndx = ux − x₀,   dy = uy − y₀\nfires if   dx ≥ 0.30 · W   and   dx ≥ 2.5 · |dy|\nthen 700 ms of cooldown; never while the palms are\nunder 0.35 m apart (that is clapping)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
