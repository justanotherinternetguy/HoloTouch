  {
   "id": "text-81",
   "type": "text",
   "x": 1730.4,
   "y": 1776.2,
   "width": 537.6,
   "height": 249.6,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
