   "roundness": null,
   "seed": 1435920784,
   "version": 1,
   "versionNonce": 745188127,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "reach     = min_i ‖hand_i − chin‖ / face size   ≤ 0.30\nmax curl                                        ≤ 0.78\ncloseness = s_hand / s_face                     ≤ 1.5\n  (1 = level with the face, 2 = at half its distance)\nheld 250 ms → window switcher\nlimits × 1.2 while the hand goes on resting there",
   "originalText": "reach     = min_i ‖hand_i − chin‖ / face size   ≤ 0.30\nmax curl                                        ≤ 0.78\ncloseness = s_hand / s_face                     ≤ 1.5\n  (1 = level with the face, 2 = at half its distance)\nheld 250 ms → window switcher\nlimits × 1.2 while the hand goes on resting there",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
