   "versionNonce": 1968847850,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "a hand starts something only if armed, not consumed,\nand not resting after spelling (0.7 s)\n\nboth hands TWO_FINGER       → Camera\nPINCH_INDEX over a window   → Move / Resize\n  (not a fullscreen one)\nPRESS, after taking AIM     → Click / drag\nPINCH_PINKY                 → Pie menu\nFIST over a window          → Close\nTWO_FINGER                  → Scroll\nCLAW                        → Knob\n  right hand: volume · left hand: brightness\nY_SIGN                      → Dictate\nILY                         → Spell / launcher\n\nclosed hand on the chin     → Window switcher\nopen palm swept right       → Enter key\ntwo claps, browser focused  → Ctrl+T\n\nleft / right: the frame is mirrored, so MediaPipe's\n\"Right\" is the user's left hand",
   "originalText": "a hand starts something only if armed, not consumed,\nand not resting after spelling (0.7 s)\n\nboth hands TWO_FINGER       → Camera\nPINCH_INDEX over a window   → Move / Resize\n  (not a fullscreen one)\nPRESS, after taking AIM     → Click / drag\nPINCH_PINKY                 → Pie menu\nFIST over a window          → Close\nTWO_FINGER                  → Scroll\nCLAW                        → Knob\n  right hand: volume · left hand: brightness\nY_SIGN                      → Dictate\nILY                         → Spell / launcher\n\nclosed hand on the chin     → Window switcher\nopen palm swept right       → Enter key\ntwo claps, browser focused  → Ctrl+T\n\nleft / right: the frame is mirrored, so MediaPipe's\n\"Right\" is the user's left hand",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
   "baseline": 398
  },
