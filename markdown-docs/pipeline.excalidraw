  {
   "id": "text-153",
   "type": "text",
   "x": 1719.2,
   "y": 4323.4,
   "width": 518.4,
   "height": 172.8,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "group-150"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1713419474,
   "version": 1,
   "versionNonce": 1201026917,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "Switcher: every window as a card in a centred grid.\n  A hand points once it has slowed to 0.3 H/s and then\n  moved 0.06·H; the highlight stays until the hand is\n  gap + 0.12 · card_w outside the card. Pinch to pick.\nDictate: Y held → parecord, 16 kHz mono WAV →\n  speech to text (Handy) → xdotool types it\nCamera: both peace signs for 3 s → the tracker gives\n  up the webcam, the camera app opens, shutter key\n  after 3 s; tracking resumes when it is closed",
   "originalText": "Switcher: every window as a card in a centred grid.\n  A hand points once it has slowed to 0.3 H/s and then\n  moved 0.06·H; the highlight stays until the hand is\n  gap + 0.12 · card_w outside the card. Pinch to pick.\nDictate: Y held → parecord, 16 kHz mono WAV →\n  speech to text (Handy) → xdotool types it\nCamera: both peace signs for 3 s → the tracker gives\n  up the webcam, the camera app opens, shutter key\n  after 3 s; tracking resumes when it is closed",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
   "baseline": 168
  },
