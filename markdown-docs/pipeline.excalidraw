  {
   "id": "text-105",
   "type": "text",
   "x": 1028.0,
   "y": 3062.6,
   "width": 508.8,
   "height": 96.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "group-102"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1649767777,
   "version": 1,
   "versionNonce": 617255373,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "gap = ‖c_a − c_b‖ / ( (s_a + s_b) / 2 )      [metres]\n  c: palm centre in frame heights, s: image scale\nclap: gap ≥ 0.14 m, then ≤ 0.08 m within 350 ms\n  (or both hands vanish ≤ 0.12 s after closing in)\ntwo claps within 900 ms, ≥ 0.1 s apart → doubled",
   "originalText": "gap = ‖c_a − c_b‖ / ( (s_a + s_b) / 2 )      [metres]\n  c: palm centre in frame heights, s: image scale\nclap: gap ≥ 0.14 m, then ≤ 0.08 m within 350 ms\n  (or both hands vanish ≤ 0.12 s after closing in)\ntwo claps within 900 ms, ≥ 0.1 s apart → doubled",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
