   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "idle = no hand seen for > 3 s\n       → infer on every 2nd frame only\nface = every 0.9 / face_hz s  (15 Hz → 60 ms)\n       every 0.5 s while idle\n> 30 failed reads → error → core restarts it",
   "originalText": "idle = no hand seen for > 3 s\n       → infer on every 2nd frame only\nface = every 0.9 / face_hz s  (15 Hz → 60 ms)\n       every 0.5 s while idle\n> 30 failed reads → error → core restarts it",
   "fontSize": 16,
   "fontFamily": 3,
