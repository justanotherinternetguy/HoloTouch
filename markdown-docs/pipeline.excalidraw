   "seed": 498123580,
   "version": 1,
   "versionNonce": 1414153797,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "PRESS → left button down at the click point\nit is a drag once ‖hand − origin‖ > 0.03·H:\n  from then the pointer follows the hand\ndouble click: a press within 1 s and 0.03·H\n  of the last one lands exactly on it\nthumb lifts → button up\n\nthe thumb only clicks from a hand that has\npointed, thumb out, for 200 ms",
   "originalText": "PRESS → left button down at the click point\nit is a drag once ‖hand − origin‖ > 0.03·H:\n  from then the pointer follows the hand\ndouble click: a press within 1 s and 0.03·H\n  of the last one lands exactly on it\nthumb lifts → button up\n\nthe thumb only clicks from a hand that has\npointed, thumb out, for 200 ms",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
