  {
   "id": "text-113",
   "type": "text",
   "x": 44.0,
   "y": 3485.6,
   "width": 547.2,
   "height": 153.6,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "group-110"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 964622594,
   "version": 1,
   "versionNonce": 862524476,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759536000000,
   "link": null,
   "locked": false,
   "text": "rect.xy = hand.xy + offset    (offset fixed at the grab)\nuntouched for the first 150 ms; over in ≤ 300 ms → undone\ntap: ≤ 400 ms, drift ≤ 0.05·H, speed ≤ 0.5 H/s\n     → the window is only brought to the front\nkept reachable: 80 px of it always stay on screen\nedge carry: hand within 0.02·W of the left or right\n  edge for 350 ms → window and view go to the next\n  workspace; then 900 ms of cooldown",
   "originalText": "rect.xy = hand.xy + offset    (offset fixed at the grab)\nuntouched for the first 150 ms; over in ≤ 300 ms → undone\ntap: ≤ 400 ms, drift ≤ 0.05·H, speed ≤ 0.5 H/s\n     → the window is only brought to the front\nkept reachable: 80 px of it always stay on screen\nedge carry: hand within 0.02·W of the left or right\n  edge for 350 ms → window and view go to the next\n  workspace; then 900 ms of cooldown",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.2,
