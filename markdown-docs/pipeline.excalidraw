   "text": "Tick loop: QTimer at the display's refresh rate  (overlay/app.py)",
   "originalText": "Tick loop: QTimer at the display's refresh rate  (overlay/app.py)",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
