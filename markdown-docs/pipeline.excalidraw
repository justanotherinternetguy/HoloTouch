  {
   "id": "text-129",
   "type": "text",
   "x": 1931.0,
   "y": 3485.6,
   "width": 412.8,
   "height": 172.8,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
